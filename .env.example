# EmailJS credentials for the contact form (Contact.jsx).
# Get these for free at https://www.emailjs.com — see EMAILJS_SETUP.md
# for the full step-by-step.
#
# 1. Copy this file to ".env" (same folder)
# 2. Fill in your real values below
# 3. Restart `npm run dev` after changing this file
#
# For Vercel: add these same 3 variables under
# Project Settings → Environment Variables, instead of (or in addition
# to) a local .env file.

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
